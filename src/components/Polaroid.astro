---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  model: string;
  cover: ImageMetadata;
  featured?: boolean;
  href?: string | null;
  label?: string;
}

const { slug, model, cover, featured, href = `/boats/${slug}`, label = model } = Astro.props;
const Tag = href ? 'a' : 'figure';
---

<Tag
  class:list={['polaroid', { 'is-featured': featured }]}
  href={href || undefined}
  data-model={model}
  transition:name={`boat-${slug}`}
>
  <span class="window">
    <Image src={cover} alt="" widths={[320, 640, 960]} sizes="(max-width: 700px) 92vw, 16rem" />
  </span>
  <p class="model">{label}</p>
</Tag>
